# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=fyp

# Security
JWT_SECRET_KEY=your_secret_key_here

# Default Model
DEFAULT_AI_MODEL=gpt-3.5-turbo

# Enabled Models (comma-separated)
ENABLED_MODELS=gpt-3.5-turbo,gemini,llama,mistral,deepseek,qwen,phi3

# API Keys
OPENAI_API_KEY=your_openai_key
GOOGLE_API_KEY=your_google_key
HUGGINGFACE_TOKEN=your_hf_token
MISTRAL_API_KEY=your_mistral_key
DEEPSEEK_API_KEY=your_deepseek_key
ALIBABA_API_KEY=your_alibaba_key
AZURE_API_KEY=your_azure_key
TOGETHER_API_KEY=your_together_key
OPENROUTER_API_KEY=your_openrouter_key

# Model Settings
BATCH_SIZE=5
MAX_RETRIES=3
REQUEST_TIMEOUT=30


# CapeV2 configuration
CAPE_API_URL=https://api.capev2.com/analyze
CAPE_API_KEY=your_capev2_key
CAPE_POLL_INTERVAL=10
CAPE_MAX_POLL=60

