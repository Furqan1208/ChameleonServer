# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=fyp

# Security
JWT_SECRET_KEY=your_secret_key_here

# Default Model
DEFAULT_AI_MODEL=

# Enabled Models (comma-separated)
ENABLED_MODELS=

# API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=
OPENROUTER_API_KEY=

# Model Settings
BATCH_SIZE=5
MAX_RETRIES=3
REQUEST_TIMEOUT=30


# CapeV2 configuration
CAPE_API_URL=https://api.capev2.com/analyze
CAPE_API_KEY=your_capev2_key
CAPE_POLL_INTERVAL=10
CAPE_MAX_POLL=60

