# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=fyp

# Security - Generate proper secrets
JWT_SECRET_KEY=your-super-secure-secret-key-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Security
BCRYPT_ROUNDS=12

# Default Model
DEFAULT_AI_MODEL=gemini-2.5-flash

# Enabled Models (comma-separated)
ENABLED_MODELS=gpt-oss-20b,gemini,llama,mistral,deepseek,qwen,phi3

# API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=
OPENROUTER_API_KEY=sk-or-v1-

# Model Settings
BATCH_SIZE=5
MAX_RETRIES=3
REQUEST_TIMEOUT=600

# CapeV2 configuration
CAPE_API_URL=http://localhost:8000/apiv2/
CAPE_API_TOKEN=
CAPE_POLL_INTERVAL=10
CAPE_MAX_POLL=60

# Security Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_FILE_SIZE_LIMIT=104857600  # 100MB in bytes
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900  # 15 minutes in seconds